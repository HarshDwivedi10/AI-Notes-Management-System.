{
  "openapi": "3.0.3",
  "info": {
    "title": "AI-Powered Notes Management System API",
    "description": "Production RESTful API documentation for the Notes Management System with AI Semantic Search and Summarization.",
    "version": "1.0.0",
    "contact": {
      "name": "PHP Backend & AI Development Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000/api",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/notes": {
      "get": {
        "summary": "Get Notes List (Paginated)",
        "description": "Fetch a paginated list of notes with optional category filtering.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (default: 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Items per page (default: 10, max: 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Filter notes by category name",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful paginated listing",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Notes retrieved successfully",
                  "data": [
                    {
                      "id": 1,
                      "title": "Vector Embeddings and Semantic Search",
                      "content": "Semantic search transforms text into embeddings...",
                      "category": "AI Research",
                      "tags": ["ai", "vector"],
                      "ai_summary": "Explains vector search...",
                      "created_at": "2026-09-06T16:00:00.000000Z",
                      "updated_at": "2026-09-06T16:00:00.000000Z"
                    }
                  ],
                  "pagination": {
                    "current_page": 1,
                    "per_page": 10,
                    "total": 12,
                    "last_page": 2,
                    "has_more_pages": true
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Note",
        "description": "Create a new note. Triggers automatic AI embedding vector indexing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoreNotePayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Note created successfully",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Note created successfully with AI vector embedding indexed",
                  "data": {
                    "id": 15,
                    "title": "New AI Note",
                    "content": "Content of the note...",
                    "category": "Ideas",
                    "tags": ["ai"],
                    "created_at": "2026-09-06T16:30:00.000000Z"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error"
          }
        }
      }
    },
    "/notes/search": {
      "get": {
        "summary": "AI Semantic Search",
        "description": "Ranks notes by conceptual vector cosine similarity to the query string.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Semantic query string",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Max results to return (default: 10)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked search results",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Found 2 semantically relevant note(s)",
                  "query": "vector similarity",
                  "count": 2,
                  "data": [
                    {
                      "id": 1,
                      "title": "Vector Embeddings and Semantic Search in PHP",
                      "content": "Semantic search transforms unstructured text...",
                      "category": "AI Research",
                      "tags": ["ai", "embeddings"],
                      "similarity_score": 0.8942,
                      "similarity_percentage": "89.4%"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Missing query string"
          }
        }
      }
    },
    "/notes/{id}": {
      "get": {
        "summary": "Get Single Note",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Note details" },
          "404": { "description": "Note not found" }
        }
      },
      "put": {
        "summary": "Update Note",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StoreNotePayload" }
            }
          }
        },
        "responses": {
          "200": { "description": "Note updated" },
          "404": { "description": "Note not found" }
        }
      },
      "delete": {
        "summary": "Delete Note",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Note deleted" },
          "404": { "description": "Note not found" }
        }
      }
    },
    "/notes/{id}/summary": {
      "post": {
        "summary": "Generate AI Note Summary",
        "description": "Generates bulleted key takeaway summary for the given note.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "AI summary generated",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "AI note summary generated successfully",
                  "data": {
                    "id": 1,
                    "title": "Vector Embeddings and Semantic Search",
                    "summary": "• Explains how numerical vector embeddings enable conceptual search matching.\n• Eliminates rigid keyword constraints using cosine similarity."
                  }
                }
              }
            }
          },
          "404": { "description": "Note not found" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StoreNotePayload": {
        "type": "object",
        "required": ["title", "content"],
        "properties": {
          "title": { "type": "string", "example": "Building APIs with Laravel 11" },
          "content": { "type": "string", "example": "Laravel 11 features streamlined routing and Form Requests." },
          "category": { "type": "string", "example": "Development" },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["laravel", "api", "php"]
          }
        }
      }
    }
  }
}
